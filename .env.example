# 本机 PostgreSQL：设置后，配置保存与更新走该数据库，基础规则使用内置副本。
# 将 your_username 替换为本机 PostgreSQL 用户，并先创建 routex 数据库。
# DATABASE_URL=postgresql://your_username@127.0.0.1:5432/routex

# 未设置 DATABASE_URL 时使用现有 Supabase 项目；通常无需修改。
# 只有切换到其他 Supabase 项目时才需要覆盖以下变量。
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# 仅旧版 /api/save 等兼容接口使用，当前 /api/config 不需要。
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
